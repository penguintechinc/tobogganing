# Tobogganing Analytics Data Aggregation Cron Jobs
# Add these entries to your crontab or place this file in /etc/cron.d/

# Run analytics aggregation every hour at minute 5
5 * * * * tobogganing cd /app/hub-api && python3 scripts/analytics_aggregator.py >> /var/log/tobogganing/analytics.log 2>&1

# Alternative: Run via Docker
# 5 * * * * root docker exec tobogganing-hub-api python3 /app/services/hub-api/scripts/analytics_aggregator.py >> /var/log/tobogganing/analytics.log 2>&1

# Cleanup old logs (daily at 2:30 AM)
30 2 * * * tobogganing find /var/log/tobogganing/ -name "*.log" -mtime +30 -delete
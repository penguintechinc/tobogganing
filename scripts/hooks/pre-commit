#!/usr/bin/env bash
# pre-commit hook — fast checks on staged files only (<30s)
# Install: make install-hooks
set -euo pipefail

BOLD='\033[1m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
fail() { echo -e "${RED}✗ pre-commit: $1${NC}" >&2; exit 1; }
info() { echo -e "${YELLOW}▶ $1${NC}"; }
ok()   { echo -e "${GREEN}✓ $1${NC}"; }

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

STAGED_GO=$(echo "$STAGED" | grep '\.go$'          || true)
STAGED_PY=$(echo "$STAGED" | grep '\.py$'          || true)
STAGED_JS=$(echo "$STAGED" | grep -E '\.(js|jsx|ts|tsx)$' || true)
STAGED_DOCKER=$(echo "$STAGED" | grep -i 'Dockerfile' || true)
STAGED_GHA=$(echo "$STAGED" | grep -E '^\.github/workflows/.*\.ya?ml$' || true)

# ── 1. Secrets (staged files only) ──────────────────────────────────────────
info "Secrets scan (gitleaks)"
if command -v gitleaks &>/dev/null; then
    gitleaks protect --staged --no-banner --exit-code 1 \
        || fail "gitleaks found secrets in staged files — remove before committing"
    ok "gitleaks clean"
else
    echo "  gitleaks not found, skipping (run: sudo apt-get install -y gitleaks)"
fi

# ── 2. Go linting ────────────────────────────────────────────────────────────
if [ -n "$STAGED_GO" ]; then
    info "Go lint (golangci-lint)"
    if ! command -v golangci-lint &>/dev/null; then
        echo "  golangci-lint not found, skipping"
    else
        # Find unique Go module roots for staged files
        GO_MODS=$(echo "$STAGED_GO" | while read -r f; do
            dir=$(dirname "$f")
            while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
                [ -f "$dir/go.mod" ] && echo "$dir" && break
                dir=$(dirname "$dir")
            done
            [ -f "go.mod" ] && echo "."
        done | sort -u)
        for mod in $GO_MODS; do
            info "  golangci-lint: $mod"
            (cd "$mod" && golangci-lint run --new-from-rev=HEAD --timeout=60s) \
                || fail "golangci-lint failed in $mod"
        done
        ok "Go lint clean"
    fi
fi

# ── 3. Python linting ────────────────────────────────────────────────────────
if [ -n "$STAGED_PY" ]; then
    info "Python lint (flake8)"
    if command -v flake8 &>/dev/null; then
        # shellcheck disable=SC2086
        flake8 $STAGED_PY || fail "flake8 failed"
        ok "flake8 clean"
    else
        echo "  flake8 not found, skipping"
    fi
fi

# ── 4. JS/TS linting ─────────────────────────────────────────────────────────
if [ -n "$STAGED_JS" ] && [ -d "services/hub-webui" ]; then
    info "JS/TS lint (eslint)"
    if [ -f "services/hub-webui/node_modules/.bin/eslint" ]; then
        # shellcheck disable=SC2086
        (cd services/hub-webui && npx eslint --no-warn-ignored $STAGED_JS) \
            || fail "eslint failed"
        ok "eslint clean"
    else
        echo "  eslint not installed (run: cd services/hub-webui && npm ci)"
    fi
fi

# ── 5. Dockerfile lint ───────────────────────────────────────────────────────
if [ -n "$STAGED_DOCKER" ]; then
    info "Dockerfile lint (hadolint)"
    if command -v hadolint &>/dev/null; then
        # shellcheck disable=SC2086
        echo "$STAGED_DOCKER" | xargs hadolint || fail "hadolint failed"
        ok "hadolint clean"
    else
        echo "  hadolint not found, skipping (run: sudo apt-get install -y hadolint)"
    fi
fi

# ── 6. GitHub Actions workflow scan ─────────────────────────────────────────
if [ -n "$STAGED_GHA" ]; then
    info "GitHub Actions scan (zizmor)"
    if command -v zizmor &>/dev/null; then
        # shellcheck disable=SC2086
        echo "$STAGED_GHA" | xargs zizmor || fail "zizmor found GHA issues"
        ok "zizmor clean"
    else
        echo "  zizmor not found, skipping (run: pip3 install zizmor --break-system-packages)"
    fi
fi

echo -e "\n${BOLD}${GREEN}pre-commit passed${NC}"

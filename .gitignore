# SASEWaddle .gitignore

# Security - Never commit these
# Next.js
.next/
out/
# Next.js (in website/)
website/.next/
website/out/
website/.vercel/
website/next-env.d.ts
website/coverage/
.vercel/
next-env.d.ts
coverage/
*secret*
id_rsa*
*.key
*.crt
*.pem
*.p12
*.pfx
certs/
certificates/
secrets/
.secrets
# ...but module certs/ source packages are code, not TLS material — keep tracked
# (path is hub_api/modules/*/certs/ after the core->hub_api rename; covers sase, sdwan, etc.)
!hub_api/modules/**/certs/
!hub_api/modules/**/certs/**

# Configuration files with sensitive data
config.yaml
config.json
*config*.yaml
*config*.json
# ...but TypeScript/tooling configs match *config*.json and MUST be committed
!tsconfig.json
!tsconfig.*.json
!**/tsconfig.json
!**/tsconfig.*.json
# ...and the pre-commit hook config matches *config*.yaml but MUST be committed
!.pre-commit-config.yaml
.env
.env.local
.env.*.local

# WireGuard configuration
*.conf
wg*.conf

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Go
*.exe
*.dll
*.so
*.dylib
*.test
*.out
build/
dist/
vendor/

# Node.js
node_modules/
npm-debug.log*
.next/
out/
node_modules/
ios/build/
android/app/build/
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.xcuserstate
*.xcworkspace
*.xcodeproj
*.swp
*.DS_Store
*.log
*.env
*.gradle
android/.gradle/
android/.idea/
android/local.properties
android/.cxx/
android/.settings/
android/build/
*.iml

# Go

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

bin/
obj/
*.exe
*.test
*.out
*.a
*.so
*.dll
*.dylib
*.cgo1.go
*.cgo2.c
*.coverprofile
*.log
*.tmp
vendor/

# Lock files that pin dependencies MUST be committed (see standards);
# only truly environment-local lockfiles may be ignored.
Cargo.lock
composer.lock

# Database files
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
.terraform.lock.hcl

# Docker
.dockerignore

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Build artifacts
sasewaddle-*
releases/
artifacts/

# Built Go headend binaries
services/hub-router/headend-proxy*
services/hub-router/headend-test
services/hub-router/test-headend
services/hub-router/proxy/headend-proxy

# Git worktrees (local development only)
.worktrees/

# Helm: packaged local sub-chart archives are a `helm dependency
# update`/`build` output regenerated from Chart.lock — the unpacked
# k8s/helm/*/charts/<name>/ source directories themselves stay tracked.
k8s/helm/*/charts/*.tgz

# stray 0-byte file some tooling keeps creating at repo root
/tobogganing

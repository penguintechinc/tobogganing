# Docker build for Tobogganing GUI client (AMD64)
# Optimized for native AMD64 builds with all GUI dependencies

FROM golang:1.24-bookworm@sha256:01f42367a0a94ad4bc17111776fd66e3500c1d87c15bbd6055b7371d39c124fb AS gui-builder-amd64

# Install GUI development dependencies for AMD64
RUN apt-get update && apt-get install -y \
    gcc \
    libc6-dev \
    libx11-dev \
    libxcursor-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxi-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libglfw3-dev \
    pkg-config \
    git \
    libayatana-appindicator3-dev \
    libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /src

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build GUI client for AMD64
ARG VERSION=dev
ARG BUILD_TIME
ARG GIT_COMMIT
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-X main.version=${VERSION} -X main.buildTime=${BUILD_TIME} -X main.gitCommit=${GIT_COMMIT} -w -s" \
    -o tobogganing-client-gui \
    ./cmd/gui

# Test stage - verify the binary was built
FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a AS test
RUN apt-get update && apt-get install -y file && rm -rf /var/lib/apt/lists/*
COPY --from=gui-builder-amd64 /src/tobogganing-client-gui /tmp/
RUN file /tmp/tobogganing-client-gui && \
    ls -la /tmp/tobogganing-client-gui

# Final stage - minimal runtime image
FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
RUN apt-get update && apt-get install -y \
    libayatana-appindicator3-1 \
    libgtk-3-0 \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gui-builder-amd64 /src/tobogganing-client-gui /usr/local/bin/tobogganing-client-gui
ENTRYPOINT ["/usr/local/bin/tobogganing-client-gui"]
# Debug Dockerfile to check file contents

FROM golang:1.23-bullseye@sha256:161b8513c09cbfa4c174fd32e46eddc5eddf487a43958b9cf8b07d628e9e0f85 AS debug

# Install basic tools
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends file tree && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copy files
COPY . .

# Show the file structure and content
RUN echo "=== File structure ===" && \
    tree -a . || ls -la && \
    echo "=== internal/gui/gui.go content ===" && \
    cat internal/gui/gui.go && \
    echo "=== go.mod content ===" && \
    head -20 go.mod && \
    echo "=== Go version ===" && \
    go version
# hadolint ignore=DL3066
USER appuser
